DATABASE_URL=postgresql+psycopg://desk:desk@localhost:5432/desk
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# claude (ANTHROPIC_API_KEY) | gemini (GEMINI_API_KEY, AI Studio free tier) | stub (keyword rules, no key; fine for CI and for developing the pipeline)
TRIAGE_PROVIDER=claude
# set to enable the Kafka transport; unset = single-process in-memory relay (desk-worker all)
KAFKA_BOOTSTRAP=
# 0..1 simulated mail-vendor failure rate, to watch the Respond saga retry and compensate
LETTER_FAIL_RATE=0
# Reg Z "business day" = days the creditor is open. Comma-separated ISO dates the servicer is closed
# beyond weekends (e.g. company holidays). Reg X days use the federal holiday table instead.
CREDITOR_CLOSED_DAYS=
